---
import UsageCards from "./UsageCards";
import { getCollection } from "astro:content";

const usageItems = await getCollection("usage");
---

<section class="relative overflow-hidden py-16 lg:py-28 px-4 sm:px-6 lg:px-8">
  
  <!-- background glow -->
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,rgba(59,130,246,0.12),transparent_40%)]"></div>

  <!-- grid effect -->
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:40px_40px]"></div>

  <div class="mx-auto max-w-7xl">
    
    <!-- header -->
    <div class="mb-14 text-center">
      <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-neutral-600">
        Explore different ways to visualize relationships and architectures
        using NodeGraph.
      </p>
    </div>

    <!-- cards -->
    <UsageCards items={usageItems} client:only="react" />
  </div>
</section>

