---
import UsageCard from "./UsageCard";
import { getCollection } from 'astro:content';

const usageItems = await getCollection('usage');
---

<section class="py-2 lg:py-32 px-4 sm:px-6 lg:px-8 bg-linear-to-b from-transparent via-blue-400/5 to-transparent">
	<div class="max-w-7xl mx-auto">
		<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
			{usageItems.map((item) => (
				<div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-[0_4px_14px_rgba(0,0,0,0.06)] hover:shadow-2xl hover:shadow-blue-500/20 transition-shadow duration-300 flex flex-col">
					<div class="h-48 w-full bg-white shrink-0">
						<UsageCard 
							graph={{
								...item.data.graph?.[0],
								links: (item.data.graph?.[0]?.links || []).map((l) => [l[0], l[1]]),
							}}
							title={item.data.title}
							description={item.data.description}
							id={item.data.id}
							client:only="react"
						/>
					</div>
					<div class="p-4 grow flex flex-col justify-between">
						<div>
							<h3 class="mb-2 text-[1.1rem] leading-[1.3]" transition:name={item.data.id}>
								{item.data.title}
							</h3>
							<p class="m-0 text-[0.95rem] leading-6 text-gray-600">
								{item.data.description}
							</p>
							<a href={`/usage/${item.data.id}`} class="mt-4 bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded">
								Learn More
							</a>
						</div>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

