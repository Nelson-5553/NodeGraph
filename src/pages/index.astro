  linkHoverWidth={1.4}
  nodeLabelColor="#D1D5DB"
  nodeLabelHoverColor="#FFFFFF"
  nodeLabelFontSize={12}
  nodeLabelShowOnHover={false}
  nodeLabelMinDegree={5}
  nodeLabelMinScale={0.25}
