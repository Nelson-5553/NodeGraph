---
import Layout from '../Layouts/Layout.astro';
import NodeGraph from '../components/NodeGraph';

const nodes = [
  { id: "Settings",          group: 0 },
  { id: "Plugins",           group: 0 },
  { id: "Core plugins",      group: 0 },
  { id: "Community plugins", group: 0 },
  { id: "Themes",            group: 0 },
  { id: "Hotkeys",           group: 0 },
  { id: "Editor",            group: 1 },
  { id: "Graph view",        group: 1 },
  { id: "Canvas",            group: 1 },
  { id: "Backlinks",         group: 1 },
  { id: "Obsidian Sync",     group: 2 },
  { id: "Obsidian Publish",  group: 2 },
  { id: "Daily notes",       group: 3 },
  { id: "Templates",         group: 3 },
  { id: "Tags",              group: 3 },
  { id: "File explorer",     group: 3 },
  { id: "Bookmarks",         group: 3 },
  { id: "Callouts",          group: 4 },
  { id: "Internal links",    group: 4 },
  { id: "Basic formatting",  group: 4 },
  { id: "Console",  group: 5 },
];
 
const links = [
  ["Settings",     "Plugins"],
  ["Settings",     "Hotkeys"],
  ["Settings",     "Editor"],
  ["Plugins",      "Core plugins"],
  ["Plugins",      "Community plugins"],
  ["Plugins",      "Themes"],
  ["Core plugins", "Daily notes"],
  ["Core plugins", "Templates"],
  ["Core plugins", "Graph view"],
  ["Core plugins", "Backlinks"],
  ["Core plugins", "Canvas"],
  ["Core plugins", "File explorer"],
  ["Core plugins", "Bookmarks"],
  ["Graph view",   "Backlinks"],
  ["Tags",         "Backlinks"],
  ["Tags",         "Console"],
  ["Internal links","Backlinks"],
  ["Internal links","Callouts"],
  ["Basic formatting","Callouts"],
  ["Basic formatting","Internal links"],
  ["Obsidian Sync","Obsidian Publish"],
  ["Daily notes",  "Templates"],
  ["Obsidian Sync",  "Templates"],
];
---

<Layout>
  <div class="flex justify-center items-center mt-5"> 
    <NodeGraph
    className='rounded-3xl shadow-lg bg-neutral-950'
    nodes={nodes as any}
    links={links as any}
    viewGuide={false}
    height={600}
    width={600}
    repulsion={60}
    colors={["#FF6B6B","#4ECDC4","#45B7D1","#FFA07A","#98D8C8", "#FFD700"]}
    client:only
    />
  </div>
</Layout>

